// Prisma Schema para Finanzas de Pareja (Fondo Común 60% + FCI + Cuotas/Recurrentes)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Household {
  id                String             @id @default(cuid())
  name              String             @default("Nuestro Hogar")
  currency          String             @default("ARS")
  defaultRate       Float              @default(0.60) // 60% por defecto
  createdAt         DateTime           @default(now())
  users             User[]
  periods           MonthlyPeriod[]
  categories        Category[]
  investments       InvestmentFund[]
  recurringExpenses RecurringExpense[]
}

model User {
  id                String                     @id @default(cuid())
  email             String                     @unique
  name              String
  avatarColor       String                     @default("#3b82f6")
  pin               String?
  magicToken        String?                    @unique
  householdId       String
  household         Household                  @relation(fields: [householdId], references: [id])
  incomes           Income[]
  expensesPaid      Expense[]                  @relation("ExpensePayer")
  recurringPaid     RecurringExpense[]         @relation("RecurringPayer")
  personalIncomes   PersonalIncome[]
  personalExpenses  PersonalExpense[]
  personalRecurring PersonalRecurringExpense[]
  createdAt         DateTime                   @default(now())
}

model MonthlyPeriod {
  id                 String                  @id @default(cuid())
  year               Int
  month              Int                     // 1 al 12
  status             String                  @default("OPEN") // OPEN, CLOSED
  carriedOverBalance Float                   @default(0)      // Saldo arrastrado del mes anterior (no invertido)
  closedAt           DateTime?               // Fecha en que se cerró el mes
  householdId        String
  household          Household               @relation(fields: [householdId], references: [id])
  incomes            Income[]
  expenses           Expense[]
  settlement         Settlement?
  investmentTransfer InvestmentContribution?
  createdAt          DateTime                @default(now())

  @@unique([householdId, year, month])
}

model Income {
  id               String        @id @default(cuid())
  amount           Float         // Sueldo neto mensual percibido
  contributionPct  Float         @default(0.60) // 60%
  targetPoolAmount Float         // amount * contributionPct
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  periodId         String
  period           MonthlyPeriod @relation(fields: [periodId], references: [id])
  createdAt        DateTime      @default(now())

  @@unique([userId, periodId])
}

model Category {
  id                String                     @id @default(cuid())
  name              String                     // Supermercado, Alquiler, Salidas, etc.
  icon              String?                    // Lucide icon name
  color             String?                    // Hex
  householdId       String
  household         Household                  @relation(fields: [householdId], references: [id])
  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  personalExpenses  PersonalExpense[]
  personalRecurring PersonalRecurringExpense[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @default(now()) @updatedAt
  lastUsedAt        DateTime?
}

model Expense {
  id                 String            @id @default(cuid())
  title              String
  amount             Float
  date               DateTime          @default(now())
  paidById           String
  paidBy             User              @relation("ExpensePayer", fields: [paidById], references: [id])
  isFromPoolFund     Boolean           @default(false)
  categoryId         String
  category           Category          @relation(fields: [categoryId], references: [id])
  periodId           String
  period             MonthlyPeriod     @relation(fields: [periodId], references: [id])
  recurringExpenseId String?
  installmentNumber  Int?              // Ej. cuota 2
  totalInstallments  Int?              // Ej. de 6
  notes              String?
  createdAt          DateTime          @default(now())
}

// Gastos recurrentes (Alquiler, Servicios fijos) y Cuotas de Tarjeta de Crédito
model RecurringExpense {
  id                String     @id @default(cuid())
  title             String
  installmentAmount Float      // Monto mensual de la cuota o servicio
  totalInstallments Int?       // ej: 6 cuotas. Null si es recurrente mensual fijo
  startYear         Int
  startMonth        Int
  paidById          String
  paidBy            User       @relation("RecurringPayer", fields: [paidById], references: [id])
  isFromPoolFund    Boolean    @default(false)
  categoryId        String
  category          Category   @relation(fields: [categoryId], references: [id])
  householdId       String
  household         Household  @relation(fields: [householdId], references: [id])
  isActive          Boolean    @default(true)
  notes             String?
  createdAt         DateTime   @default(now())
}

model Settlement {
  id             String        @id @default(cuid())
  periodId       String        @unique
  period         MonthlyPeriod @relation(fields: [periodId], references: [id])
  totalPool      Float         // Aportes totales 60%
  totalSpent     Float         // Gastos totales del mes
  surplus        Float         // Remanente (totalPool - totalSpent)
  netBalanceA    Float         // Balance de bolsillo persona A
  netBalanceB    Float         // Balance de bolsillo persona B
  transferAmount Float         // Monto de compensación entre ambos
  payerId        String?
  receiverId     String?
  settledAt      DateTime?
}

// Fondo Común de Inversión (FCI) para los remanentes
model InvestmentFund {
  id            String                   @id @default(cuid())
  householdId   String
  household     Household                @relation(fields: [householdId], references: [id])
  name          String                   @default("FCI Ahorro Pareja")
  currentValue  Float                    @default(0)
  contributions InvestmentContribution[]
  updatedAt     DateTime                 @updatedAt
}

model InvestmentContribution {
  id         String         @id @default(cuid())
  fundId     String
  fund       InvestmentFund @relation(fields: [fundId], references: [id])
  periodId   String         @unique
  period     MonthlyPeriod  @relation(fields: [periodId], references: [id])
  amount     Float          // Monto del remanente invertido
  userAQuota Float          // Cuota atribuible a A
  userBQuota Float          // Cuota atribuible a B
  investedAt DateTime       @default(now())
}

// Finanzas Personales (40% restante + extras/bonos)
model PersonalIncome {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id])
  year               Int
  month              Int
  extraAmount        Float     @default(0) // Bonos extra, ingresos adicionales personales
  carriedOverBalance Float     @default(0) // Saldo arrastrado del mes personal anterior
  status             String    @default("OPEN") // OPEN, CLOSED
  closedAt           DateTime?
  notes              String?
  createdAt          DateTime  @default(now())

  @@unique([userId, year, month])
}

model PersonalExpense {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  year                Int
  month               Int
  title               String
  amount              Float
  date                DateTime  @default(now())
  categoryId          String?
  category            Category? @relation(fields: [categoryId], references: [id])
  personalRecurringId String?
  installmentNumber   Int?      // Ej. cuota 2
  totalInstallments   Int?      // Ej. de 6
  notes               String?
  createdAt           DateTime  @default(now())
}

model PersonalRecurringExpense {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  title             String
  installmentAmount Float     // Monto mensual de la cuota o servicio personal
  totalInstallments Int?      // ej: 6 cuotas. Null si es recurrente mensual fijo
  startYear         Int
  startMonth        Int
  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [id])
  isActive          Boolean   @default(true)
  notes             String?
  createdAt         DateTime  @default(now())
}

